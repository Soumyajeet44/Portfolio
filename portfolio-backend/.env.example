# MongoDB Atlas connection string. Never commit a real .env file.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
PORT=5000
NODE_ENV=development
# Comma-separated exact origins. Add the deployed frontend URL in production.
CLIENT_ORIGINS=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=2h
COOKIE_NAME=portfolio_admin
ADMIN_NAME=Soumyajeet Mahanta
ADMIN_EMAIL=soumyajeetmahanta2@gmail.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
